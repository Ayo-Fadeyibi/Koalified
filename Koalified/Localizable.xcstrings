    "Widgets are added from your Home Screen: touch and hold, tap +, then choose Koalified and a size." : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "विजेट आपकी होम स्क्रीन से जोड़े जाते हैं : होम स्क्रीन को टच करके रखें, + पर टैप करें, फिर Koalified और साइज़ चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Widget ditambahkan dari Layar Utama: sentuh dan tahan, ketuk +, lalu pilih Koalified dan ukurannya."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "ウィジェットはホーム画面から追加します。ホーム画面を長押しして+をタップし、Koalifiedとサイズを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "위젯은 홈 화면에서 추가해요. 홈 화면을 길게 누르고 +를 탭한 다음 Koalified와 크기를 선택하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Bạn thêm widget từ Màn hình chính: chạm và giữ, chạm vào +, rồi chọn Koalified và kích thước."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "小组件需要在主屏幕上添加：长按主屏幕，轻点 +，然后选择 Koalified 和尺寸。"
          }
        },
        "zh-Hant" : {
