    "Enter assessment names, weights and dates yourself. No automatic lookup or course-profile extraction" : {
      "localizations" : {
        "hi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "मूल्यांकन के नाम, वेटेज और तारीख़ें खुद दर्ज करें। कोई ऑटोमैटिक लुकअप या कोर्स-प्रोफ़ाइल एक्सट्रैक्शन नहीं होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Masukkan nama, bobot, dan tanggal penilaian sendiri. Tanpa pencarian otomatis atau pengambilan profil mata kuliah"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "評価の名前、比重、日付を自分で入力します。自動検索や科目プロフィールの抽出は行いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "평가 이름, 비중, 날짜를 직접 입력해요. 자동 조회나 과목 프로필 추출은 하지 않아요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Tự nhập tên, trọng số và ngày của các bài đánh giá. Không tự động tra cứu hoặc trích xuất đề cương môn học"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "machine_translated",
