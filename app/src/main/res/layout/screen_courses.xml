<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/k_screen_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="@dimen/k_screen_padding"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/k_screen_padding">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/k_courses_title"
                android:textColor="@color/k_text_primary"
                android:textSize="26sp"
                android:textStyle="bold" />
            <ImageButton
                android:id="@+id/courses_profile_button"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/k_profile_avatar"
                android:contentDescription="Profile"
                android:src="@drawable/ic_launcher_foreground"
                android:scaleType="centerInside"
                android:padding="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingBottom="72dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/k_neo_card"
                android:orientation="vertical"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/k_courses_empty_title"
                    android:textColor="@color/k_text_primary"
                    android:textSize="23sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/k_courses_empty_message"
                    android:textColor="@color/k_text_secondary"
                    android:textSize="15sp" />
                <Button
                    android:id="@+id/action_add_course"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:backgroundTint="@color/k_brand_mint"
                    android:text="@string/k_add_course"
                    android:textAllCaps="false"
                    android:textColor="@color/k_on_mint"
                    android:textStyle="bold" />
                <Button
                    android:id="@+id/action_courses_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/k_card_surface"
                    android:text="@string/k_import_timetable"
                    android:textAllCaps="false"
                    android:textColor="@color/k_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <ImageButton
        android:id="@+id/courses_add_fab"
        android:layout_width="@dimen/k_fab_size"
        android:layout_height="@dimen/k_fab_size"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/k_mint_pill"
        android:contentDescription="@string/k_add_course"
        android:src="@android:drawable/ic_input_add"
        android:tint="@color/k_on_mint" />
</FrameLayout>
